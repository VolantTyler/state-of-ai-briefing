# The refresh runs in GitHub Actions (docs/refresh.md), not in a Vercel
# function. Add the secret names from that doc under Settings → Secrets and
# variables → Actions. This file is the shape of the process environment the
# script reads. The contents PAT is the Actions secret GH_CONTENTS_TOKEN; the
# workflow assigns it to GITHUB_TOKEN for the script. Do not create an Actions
# secret named GITHUB_TOKEN — that name is reserved for the built-in token.

# Anthropic API key — used ONLY by scripts/refresh.js, never shipped to the browser
ANTHROPIC_API_KEY=sk-ant-...

# TypeSafe API key — used ONLY by the valuations panel, never shipped to the browser
TYPESAFE_API_KEY=
# Valuations model when ANTHROPIC_MODEL_VALUATIONS is unset. Simple panels
# (models, users, share, capital, energy) default to claude-haiku-4-5-20251001
# and do not read this variable.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional per-panel override. Wins over both defaults above.
# Names: ANTHROPIC_MODEL_VALUATIONS, ANTHROPIC_MODEL_MODELS, ANTHROPIC_MODEL_USERS,
# ANTHROPIC_MODEL_SHARE, ANTHROPIC_MODEL_CAPITAL, ANTHROPIC_MODEL_ENERGY.
# These are Anthropic model ids (for example claude-haiku-4-5), not another provider.

# List-price ceiling for one /api/refresh run, in USD. Once the running
# estimate reaches it, later Claude calls are not started and those panels
# keep their prior values. The reason is written to public/data/usage.json.
# Unset means 1.
REFRESH_MAX_USD=1

# Fine-grained GitHub PAT with Contents: read+write on this repo only.
# In Actions this value is the secret GH_CONTENTS_TOKEN.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=your-username/state-of-ai-briefing
GITHUB_BRANCH=main

# No longer read by the refresh. /api/refresh has been removed. /api/status
# still accepts it as a bearer token when it is set on the Vercel project.
CRON_SECRET=

# Optional clocks, milliseconds. Unset means the Actions defaults in
# src/refresh-budget.js: 25 min job, 2 min tail, 10 min per-call cap,
# valuations may use the rest of the job budget and will not start with
# less than 10 min left. The workflow timeout is 30 min.
# REFRESH_MAX_DURATION_MS=1500000
# REFRESH_TAIL_RESERVE_MS=120000
# REFRESH_CALL_TIMEOUT_MS=600000
# REFRESH_VALUATIONS_CALL_TIMEOUT_MS=
# REFRESH_VALUATIONS_MIN_START_MS=600000

# ——— Failure alerts (optional; both channels are best-effort) ———
# Set these as Actions secrets (see docs/refresh.md). The job never reads a
# local `.env`. Alerts fire on total failure, partial panel failure, and
# crashes.

# Email via AgentMail (https://www.agentmail.to) — all three required to arm
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=your-inbox@agentmail.to
NOTIFY_EMAIL=you@example.com

# Cursor Grok Bot webhook routine — both required to arm the bot wake
# Create a webhook routine on your Bot, then copy POST URL + key from the panel.
GROK_BOT_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/...
GROK_BOT_WEBHOOK_KEY=
