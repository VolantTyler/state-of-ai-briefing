{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [],
  "functions": {
    "api/refresh.js": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
